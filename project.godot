[layer_names]

3d_physics/layer_1="Player"
3d_physics/layer_2="Level"
3d_physics/layer_3="Level (Non-Player)"

[physics]

3d/run_on_separate_thread=true
3d/physics_engine="GodotPhysics3D"
3d/solver/solver_iterations=32

[rendering]

